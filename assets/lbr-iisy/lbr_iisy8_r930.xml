                <joint name="joint_5" axis="0 0 1" range="-1.91986 1.91986" actuatorfrcrange="-58.5802975910498 58.5802975910498"/>  <!-- max velocity 4.537856055185257 rad/s -->
                <geom class="visual" mesh="link_5" pos="-0.367 0.685 -0.0507" quat="0.707107 0.707107 -2.16489e-17 -2.16489e-17" material="pearl"/>
                <geom class="collision" mesh="link_5_collision"/>
                <body name="link_6" pos="0.0837 0 -0.0507" quat="0.5 0.5 -0.5 -0.5">
                  <inertial pos="-0.0179504 0.0194973 -0.0304582" quat="0.5 0.5 -0.5 0.5" mass="1.5066" diaginertia="0.00403512 0.00390274 0.00286931"/>
                  <joint name="joint_6" axis="0 0 1" range="-3.83972 3.83972" actuatorfrcrange="-15.9275678542121 15.9275678542121"/>  <!-- max velocity 7.504915783575617 rad/s -->
                  <geom class="visual" mesh="link_6" pos="-0.685 -1.88805e-17 0.4507" quat="0.707107 4.32978e-17 0.707107 -4.32978e-17" material="wrist"/>
